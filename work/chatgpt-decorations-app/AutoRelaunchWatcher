#!/bin/zsh
set -u

STABLE_APP="${1:-$HOME/Applications/ChatGPT 装饰版.app}"
SUPPORT="$HOME/Library/Application Support/ChatGPTDecorations"
DISABLED_MARKER="$SUPPORT/auto-relaunch.disabled"
LOG_DIR="$HOME/Library/Logs/ChatGPTDecorationsLauncher"
LOG_FILE="$LOG_DIR/auto-relaunch.log"
source "$STABLE_APP/Contents/Resources/theme/app-discovery.zsh"

mkdir -p "$SUPPORT" "$LOG_DIR"

log_message() {
  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG_FILE"
}

log_message "更新重启接管器已启动，装饰版路径：$STABLE_APP"

update_install_running() {
  /bin/ps -axo command= | /usr/bin/awk '
    /\/Sparkle\.framework\// || /\/Updater\.app\/Contents\/MacOS\/Updater/ {
      if ($0 !~ /\/usr\/bin\/awk/) { found = 1; exit }
    }
    END { exit(found ? 0 : 1) }
  '
}

observed_plain_pid=""
plain_since=0
retry_after=0

while true; do
  if [[ -f "$DISABLED_MARKER" || ! -x "$STABLE_APP/Contents/MacOS/ChatGPTDecorationsLauncher" ]]; then
    sleep 2
    continue
  fi

  plain_pid=""
  decorated_port=""
  pids="$(openai_main_process_pids)"
  for pid in ${(f)pids}; do
    [[ "$pid" == <-> ]] || continue
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ "$command_line" == *"/Contents/MacOS/ChatGPT"* ]] || continue
    if [[ "$command_line" != *"--remote-debugging-port="* ]]; then
      [[ -z "$plain_pid" ]] && plain_pid="$pid"
    elif [[ -z "$decorated_port" ]]; then
      decorated_port="${${command_line#*--remote-debugging-port=}%% *}"
    fi
  done

  if [[ -z "$plain_pid" ]]; then
    observed_plain_pid=""
    retry_after=0
    if [[ "$decorated_port" == <-> ]]; then
      if ! /bin/ps -axo command= | /usr/bin/awk -v port="$decorated_port" '
        index($0, "injector.cjs") > 0 && index($0, "--port " port) > 0 { found = 1; exit }
        END { exit(found ? 0 : 1) }
      '; then
        theme="$STABLE_APP/Contents/Resources/theme"
        node="/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
        [[ -x "$node" ]] || node="$(command -v node 2>/dev/null || true)"
        if [[ -n "$node" && -f "$theme/injector.cjs" && -f "$SUPPORT/decorations.json" ]]; then
          runtime_log_dir="$HOME/Library/Logs/SnowMikuCodexRuntime"
          state_dir="$HOME/Library/Application Support/SnowMikuEmbeddedConversation"
          mkdir -p "$runtime_log_dir" "$state_dir"
          nohup "$node" "$theme/injector.cjs" --config "$SUPPORT/decorations.json" --port "$decorated_port" \
            >> "$runtime_log_dir/injector-$decorated_port.log" 2>&1 &!
          print -r -- "$!" > "$state_dir/injector.pid"
          log_message "检测到注入器退出，已在端口 $decorated_port 原地恢复。"
        fi
      fi
    fi
    sleep 2
    continue
  fi

  now="$(date +%s)"
  if [[ "$plain_pid" != "$observed_plain_pid" ]]; then
    observed_plain_pid="$plain_pid"
    plain_since="$now"
    retry_after=0
    log_message "检测到普通模式进程（PID $plain_pid），等待更新和首次启动完成。"
  fi
  if (( now - plain_since < 45 || now < retry_after )) || update_install_running || [[ "$decorated_port" == <-> ]]; then
    sleep 2
    continue
  fi

  # 再次确认同一进程仍在普通模式，避免关闭刚完成的装饰版启动。
  sleep 2
  command_line="$(ps -p "$plain_pid" -o command= 2>/dev/null || true)"
  if [[ -z "$command_line" || "$command_line" == *"--remote-debugging-port="* || -f "$DISABLED_MARKER" ]] \
    || [[ "$(openai_main_process_pids)" != "$plain_pid" ]] || update_install_running; then
    continue
  fi

  log_message "检测到原版直接重启（PID $plain_pid），切换到装饰版。"
  osascript -e 'with timeout of 5 seconds' -e 'tell application id "com.openai.codex" to quit' -e 'end timeout' >/dev/null 2>&1 || true
  for _ in {1..120}; do
    openai_main_process_running || break
    sleep 0.25
  done

  if [[ ! -f "$DISABLED_MARKER" ]] && ! openai_main_process_running && ! update_install_running; then
    /usr/bin/open "$STABLE_APP"
    log_message "已从固定路径启动装饰版。"
  else
    retry_after="$(($(date +%s) + 30))"
    log_message "原版进程或更新程序仍在运行，本轮等待自然退出。"
  fi
  sleep 5
done
